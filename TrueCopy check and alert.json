      "parameters": {
        "jsCode": "// Placeholder: paste your Load facts code here\n// Input items = rows of the text CSV (needs a 'text' column).\n// Facts rows: $('Read facts CSV').all()\nreturn $input.all();"
      },
      "id": "c23bb0a9-cc34-4322-8297-54080842cc70",
      "name": "Load facts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        112
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You extract checkable factual claims from product or customer-service text. Do not judge whether claims are true. quote must be copied exactly, character for character, from the text and be as short as possible while containing the claim (for example 100% organic linen, not the whole sentence). attribute must be one of: material, dimensions, weight, color, price, certification, origin, care, return_window, refund_time, dispatch_time, delivery_time, free_shipping, warranty. Map proof, health, safety, eco, award and superlative claims (certified, clinically proven, eco-friendly, best) to certification. type is one of spec, material, price, certification, policy, superlative. productHint is the product name if the text names it, otherwise omit it. Ignore opinions and style (perfect for gifts, beautiful). Skip claims that fit no attribute. If there are none return an empty claims array."
            }
          ]
        },
        "batching": {}
      },
      "id": "9154342d-8537-4082-a7d1-ff367d70c8c7",
      "name": "Extract claims",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        816,
        112
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1",
          "cachedResultName": "gpt-4.1"
        },
        "builtInTools": {},
        "options": {
          "temperature": 0
        }
      },
      "id": "09029fdd-9457-4a38-b8c9-2c9e0afc32ec",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        832,
        336
      ],
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"claims\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"quote\": {\n            \"type\": \"string\"\n          },\n          \"productHint\": {\n            \"type\": \"string\"\n          },\n          \"attribute\": {\n            \"type\": \"string\"\n          },\n          \"value\": {\n            \"type\": \"string\"\n          },\n          \"type\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"quote\",\n          \"attribute\",\n          \"value\",\n          \"type\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"claims\"\n  ]\n}"
      },
      "id": "64bd653f-7a30-44e8-ac11-1c2ac00cfa8d",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        960,
        336
      ]
    },
    {
      "parameters": {
        "jsCode": "const facts = $('Read facts CSV').all().map(f => f.json);\nconst texts = $('Load facts').all();\nconst norm = s => String(s ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');\n\nreturn $input.all().map((item, i) => {\n  const claims = (item.json.output && item.json.output.claims) || [];\n  const mismatches = [];\n  for (const c of claims) {\n    const product = c.productHint || 'Store policy';\n    const fact = facts.find(f => norm(f.product) === norm(product) && f.attribute === c.attribute);\n    if (!fact) continue;\n    const claimed = norm(c.value);\n    const truth = norm(fact.value);\n    if (!claimed.includes(truth) && !truth.includes(claimed)) {\n      mismatches.push({ quote: c.quote, attribute: c.attribute, claimed: c.value, fact: fact.value });\n    }\n  }\n  const named = claims.find(c => c.productHint);\n  return {\n    json: {\n      text: texts[i] ? texts[i].json.text : '',\n      productName: named ? named.productHint : 'Store policy',\n      flagged: mismatches.length > 0,\n      mismatches,\n    },\n  };\n});"
      },
      "id": "84365d4f-c956-4c42-85d1-9fa1d1b3173c",
      "name": "Judge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        112
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.flagged }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "04bded49-5b8f-41d1-af12-5af0cf3019b5",
      "name": "Flagged?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1392,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nreturn $input.all().map(item => {\n  const productName = item.json.productName;\n  const text = item.json.text;\n  const mismatches = item.json.mismatches || [];\n  const rows = mismatches.map(m => '<tr><td>' + esc(m.quote) + '</td><td>' + esc(m.attribute) + '</td><td>' + esc(m.claimed) + '</td><td>' + esc(m.fact) + '</td></tr>').join('');\n  const html = '<p><b>Product:</b> ' + esc(productName) + '</p><p><b>Text:</b> ' + esc(text) + '</p>'\n    + '<table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse\"><tr><th>Quote</th><th>Attribute</th><th>Claimed</th><th>Fact</th></tr>' + rows + '</table>'\n    + '<p>Approve to confirm these claims are wrong. Dismiss to ignore this alert.</p>';\n  const plain = mismatches.map(m => '- \"' + m.quote + '\" (' + m.attribute + '): claimed ' + m.claimed + ', fact is ' + m.fact).join('\\n');\n  return {\n    json: {\n      productName,\n      subject: 'TrueCopy alert: ' + mismatches.length + ' wrong claim(s) in ' + productName,\n      html,\n      plain,\n    },\n  };\n});"
      },
